using System;
namespace Buoi_3
{
	public class Cau_2
	{
		public Cau_2()
		{
			Console.WriteLine("Chiều cao (m): ");
			double.TryParse(Console.ReadLine(), out double chieuCao);
            Console.WriteLine("Cân nặng (kg): ");
			double.TryParse(Console.ReadLine(), out double canNang);
			double chiSoBMI = canNang / Math.Pow(chieuCao, 2);
			Console.WriteLine($"Chỉ số BMI của bạn: {chiSoBMI}");
			if (chiSoBMI<18.5)
			{
				Console.WriteLine("Gầy (Thiếu cân)");
			}
			else if (chiSoBMI<23.0)
			{
				Console.WriteLine(" Bình thường (Lý Tưởng)");
			}
			else if (chiSoBMI<25.0)
			{
				Console.WriteLine("Thừa cân (Béo phì)");
			}
			double canNangToiThieu = 18.5 * Math.Pow(chieuCao, 2);
			double canNangToiDa = 22.9 * Math.Pow(chieuCao, 2);
			Console.WriteLine($"Khuyên dùng: Cân nặng lý tưởng của bạn nên từ {canNangToiThieu} kg đếb {canNangToiDa} kg");
        }
    }
}

